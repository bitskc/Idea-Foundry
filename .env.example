# === SERVER ONLY (never prefix with VITE_) ===

# Database — Neon Postgres (Netlify/Vercel integration sets ideas_DATABASE_URL or POSTGRES_URL automatically)
DATABASE_URL="postgres://user:password@ep-your-neon-host.neon.tech/dbname?sslmode=require"

# Auth
JWT_SECRET=
ENCRYPTION_KEY=

# AI Configuration
GEMINI_API_KEY="your_gemini_key_here"
GEMINI_MODEL=
ANTHROPIC_API_KEY="your_anthropic_key_here"  # Optional
ANTHROPIC_MODEL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Server
PORT=5000
NODE_ENV="development"
