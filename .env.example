# === SERVER ONLY (never prefix with VITE_) ===

# Database - Use Supabase connection pooling with prepare=false
DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&prepare=false"

# Supabase - Server-side (use same URL as client, but separate env var)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_KEY="eyJh..." # WARNING: Keep secret! Never expose to client.

# AI Configuration
GEMINI_API_KEY="your_gemini_key_here"
ANTHROPIC_API_KEY="your_anthropic_key_here"  # Optional

# Server
PORT=5000
NODE_ENV="development"

# === CLIENT (VITE_ prefix exposes to browser - safe to expose) ===

VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJh..."  # This is the public anon key, safe to expose
